<Window x:Class="Belac.Dock.App.Views.ConnectUsageWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:local="clr-namespace:Belac.Dock.App" local:DialogChrome.DarkCaption="True"
 Title="Connect AI usage" Width="640" Height="660" MinWidth="540" MinHeight="520"
 WindowStartupLocation="CenterOwner" Background="{DynamicResource Brush.Background}" Foreground="{DynamicResource Brush.Foreground}" FontFamily="Segoe UI Variable Text, Segoe UI">
 <DockPanel Margin="28">
  <StackPanel DockPanel.Dock="Top" Margin="0,0,0,20">
   <TextBlock Text="Connect AI usage" FontSize="26" FontWeight="SemiBold"/>
   <TextBlock x:Name="StepLabel" Foreground="{DynamicResource Brush.Accent}" Margin="0,8,0,0"/>
  </StackPanel>
  <Grid DockPanel.Dock="Bottom" Margin="0,18,0,0">
   <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <Button Style="{StaticResource TextButton}" HorizontalAlignment="Left" Content="Set up later" Click="Later_Click"/>
   <Button x:Name="BackButton" Grid.Column="1" Style="{StaticResource TextButton}" Content="Back" Click="Back_Click"/>
   <Button x:Name="NextButton" Grid.Column="2" Style="{StaticResource TextButton}" Content="Next" Click="Next_Click"/>
  </Grid>
  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
   <StackPanel>
    <StackPanel x:Name="InstallStep">
     <TextBlock Text="1. Choose your AI providers" FontSize="19" FontWeight="SemiBold"/>
     <TextBlock Style="{StaticResource BodyText}" Margin="0,12,0,18" Text="Connect directly using the accounts you already use on this PC. No companion app is required."/>
     <Border Style="{StaticResource WorkspaceCard}" Padding="16"><StackPanel>
      <CheckBox x:Name="CodexBox" Content="Codex — ChatGPT account" Margin="0,6"/>
      <CheckBox x:Name="WslBox" Content="Include Codex in running WSL distributions" Margin="20,6,0,6"/>
      <CheckBox x:Name="ClaudeBox" Content="Claude — Claude Code account" Margin="0,6"/>
      <CheckBox x:Name="CursorBox" Content="Cursor — desktop account" Margin="0,6"/>
     </StackPanel></Border>
     <TextBlock Style="{StaticResource MutedText}" Margin="0,16,0,0" Text="The dock reads existing sign-ins and sends each token only to its provider. Tokens are never copied into dock settings or logs. Your apps keep control of sign-in and session renewal."/>
     <Expander Header="Other providers / optional fallback" Margin="0,20,0,0"><StackPanel Margin="0,12,0,0">
      <CheckBox x:Name="FallbackBox" Content="Also read OpenTokenUsage when it is running"/>
      <TextBlock Style="{StaticResource MutedText}" Margin="0,8,0,0" Text="Optional support for other providers. Native readings take priority; this option requires the companion only for fallback readings."/>
      <Button Style="{StaticResource TextButton}" Content="Open optional companion" Click="Open_Click" HorizontalAlignment="Left"/>
     </StackPanel></Expander>
     <Button Style="{StaticResource TextButton}" Content="Save choices without connecting" Click="SaveChoices_Click" HorizontalAlignment="Left" Margin="0,12,0,0"/>
    </StackPanel>
    <StackPanel x:Name="AccountsStep" Visibility="Collapsed">
     <TextBlock Text="2. Sign in once in your provider app" FontSize="19" FontWeight="SemiBold"/>
     <TextBlock Style="{StaticResource BodyText}" Margin="0,12,0,0" Text="Already signed in on this Windows PC? Choose Next. The dock detects supported local sign-ins automatically, including after you restart it."/>
     <TextBlock Style="{StaticResource BodyText}" Margin="0,16,0,0" Text="Codex: sign in with your ChatGPT account. File-based Codex sign-ins are supported. API keys, memory-only sessions and keyring-only sign-ins do not provide a supported local connection yet."/>
     <TextBlock Style="{StaticResource BodyText}" Margin="0,12,0,0" Text="Claude: sign in to Claude Code on Windows. A claude.ai browser session alone will not connect. Cursor: sign in to the Cursor desktop app."/>
     <TextBlock Style="{StaticResource FieldLabel}" Text="Need the provider app?"/>
     <ComboBox x:Name="ProviderHelp" SelectedIndex="0" AutomationProperties.Name="Provider setup help">
      <ComboBoxItem Content="Codex" Tag="codex"/><ComboBoxItem Content="Claude" Tag="claude"/><ComboBoxItem Content="Cursor" Tag="cursor"/>
     </ComboBox>
     <Button Style="{StaticResource TextButton}" Content="Open official provider page" HorizontalAlignment="Left" Margin="0,8,0,0" Click="ProviderHelp_Click"/>
     <TextBlock Style="{StaticResource MutedText}" Margin="0,16,0,0" Text="If a session expires, open that app to renew it and check again. No passwords or tokens to paste here. Codex accounts in running WSL distributions are detected separately. Stopped distributions are left alone."/>
    </StackPanel>
    <StackPanel x:Name="CheckStep" Visibility="Collapsed">
     <TextBlock Text="3. Check your connection" FontSize="19" FontWeight="SemiBold"/>
     <TextBlock x:Name="ConnectionTitle" FontSize="16" FontWeight="SemiBold" Margin="0,16,0,8" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/>
     <TextBlock x:Name="ConnectionDetail" Style="{StaticResource BodyText}"/>
     <Button x:Name="CheckButton" Style="{StaticResource TextButton}" Content="Check again" Click="Check_Click" HorizontalAlignment="Left" Margin="0,12,0,12"/>
     <Button x:Name="ReconnectCursorButton" Style="{StaticResource TextButton}" Content="Reconnect Cursor" Click="ReconnectCursor_Click" HorizontalAlignment="Left" Margin="0,0,0,12"/>
     <TextBlock x:Name="CursorReconnectHelp" Style="{StaticResource MutedText}" Margin="0,0,0,12" Text="Reconnect attempts to renew your Cursor session. If Cursor requires a new login, it opens the app. Sign in there, then choose Check again."/>
     <ItemsControl x:Name="Readings"><ItemsControl.ItemTemplate><DataTemplate>
      <Border Style="{StaticResource WorkspaceCard}" Padding="12" Margin="0,0,0,8"><StackPanel>
       <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextWrapping="Wrap"/>
       <TextBlock Text="{Binding Detail}" Style="{StaticResource MutedText}" Margin="0,4,0,0"/>
      </StackPanel></Border>
     </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
     <TextBlock Style="{StaticResource MutedText}" Text="The dock refreshes in the background: at most every two minutes for Codex and Cursor, and five minutes for Claude. Provider rate limits may delay refreshes."/>
    </StackPanel>
    <Button Style="{StaticResource TextButton}" Content="Read the step-by-step setup guide ↗" HorizontalAlignment="Left" Margin="0,20,0,0" Click="Guide_Click"/>
    <TextBlock x:Name="ActionError" Foreground="{DynamicResource Brush.Warn}" TextWrapping="Wrap" Margin="0,8,0,0" AutomationProperties.LiveSetting="Polite"/>
   </StackPanel>
  </ScrollViewer>
 </DockPanel>
</Window>
