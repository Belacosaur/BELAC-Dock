<Window x:Class="Belac.Dock.App.Views.ConnectUsageWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:local="clr-namespace:Belac.Dock.App" local:DialogChrome.DarkCaption="True"
 Title="Connect AI usage" Width="640" Height="660" MinWidth="540" MinHeight="520"
 WindowStartupLocation="CenterOwner" Background="{DynamicResource Brush.Background}" Foreground="{DynamicResource Brush.Foreground}" FontFamily="Segoe UI Variable Text, Segoe UI">
 <DockPanel Margin="28">
  <StackPanel DockPanel.Dock="Top" Margin="0,0,0,20">
   <TextBlock Text="Connect AI usage" FontSize="26" FontWeight="SemiBold"/>
   <TextBlock x:Name="StepLabel" Foreground="{DynamicResource Brush.Accent}" Margin="0,8,0,0"/>
  </StackPanel>
  <Grid DockPanel.Dock="Bottom" Margin="0,18,0,0">
   <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <Button Style="{StaticResource TextButton}" HorizontalAlignment="Left" Content="Set up later" Click="Later_Click"/>
   <Button x:Name="BackButton" Grid.Column="1" Style="{StaticResource TextButton}" Content="Back" Click="Back_Click"/>
   <Button x:Name="NextButton" Grid.Column="2" Style="{StaticResource TextButton}" Content="Next" Click="Next_Click"/>
  </Grid>
  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
   <StackPanel>
    <StackPanel x:Name="InstallStep">
     <TextBlock Text="1. Get the companion app" FontSize="19" FontWeight="SemiBold"/>
     <TextBlock Style="{StaticResource BodyText}" Margin="0,12,0,18" Text="OpenTokenUsage connects to your AI accounts and reads their usage. BELAC Dock displays those readings. You only need to set up the companion once."/>
     <Border Style="{StaticResource WorkspaceCard}" Padding="16"><StackPanel>
      <TextBlock x:Name="InstallStatus" Text="Checking your computer…" TextWrapping="Wrap"/>
      <WrapPanel Margin="0,12,0,0">
       <Button Style="{StaticResource TextButton}" Content="Download OpenTokenUsage" Click="Download_Click"/>
       <Button Style="{StaticResource TextButton}" Content="Open OpenTokenUsage" Click="Open_Click"/>
      </WrapPanel>
     </StackPanel></Border>
     <TextBlock Style="{StaticResource BodyText}" Margin="0,16,0,0" Text="Download the Windows x64 setup file from the official release page, run it, then open OpenTokenUsage. Already installed? Choose Open OpenTokenUsage or find it in Windows Start."/>
     <TextBlock Style="{StaticResource MutedText}" Margin="0,12,0,0" Text="Downloads open in your browser. Nothing is installed automatically. The dock works without AI usage too."/>
    </StackPanel>
    <StackPanel x:Name="AccountsStep" Visibility="Collapsed">
     <TextBlock Text="2. Connect your providers" FontSize="19" FontWeight="SemiBold"/>
     <TextBlock Style="{StaticResource BodyText}" Margin="0,12,0,0" Text="In OpenTokenUsage, enable the providers you use. Follow each provider's setup or sign-in guidance, then refresh its panel until you see usage readings."/>
     <TextBlock Style="{StaticResource BodyText}" Margin="0,14,0,0" Text="Already signed into a coding app? Some providers can use that existing sign-in. Others need additional setup. Signing into a website alone may not be enough."/>
     <Button Style="{StaticResource TextButton}" Content="Open OpenTokenUsage" HorizontalAlignment="Left" Margin="0,16,0,0" Click="Open_Click"/>
     <TextBlock Style="{StaticResource FieldLabel}" Text="Help for your provider"/>
     <ComboBox x:Name="ProviderHelp" SelectedIndex="0" AutomationProperties.Name="Provider setup help">
      <ComboBoxItem Content="Codex" Tag="codex"/><ComboBoxItem Content="Claude" Tag="claude"/><ComboBoxItem Content="Cursor" Tag="cursor"/><ComboBoxItem Content="GitHub Copilot" Tag="copilot"/><ComboBoxItem Content="Other providers" Tag="all"/>
     </ComboBox>
     <Button Style="{StaticResource TextButton}" Content="Open provider instructions" HorizontalAlignment="Left" Margin="0,8,0,0" Click="ProviderHelp_Click"/>
     <TextBlock Style="{StaticResource MutedText}" Margin="0,16,0,0" Text="Complete sign-ins in the provider's app or browser. BELAC Dock never asks you to paste passwords, API keys or session tokens."/>
    </StackPanel>
    <StackPanel x:Name="CheckStep" Visibility="Collapsed">
     <TextBlock Text="3. Check your connection" FontSize="19" FontWeight="SemiBold"/>
     <TextBlock x:Name="ConnectionTitle" FontSize="16" FontWeight="SemiBold" Margin="0,16,0,8" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/>
     <TextBlock x:Name="ConnectionDetail" Style="{StaticResource BodyText}"/>
     <Button x:Name="CheckButton" Style="{StaticResource TextButton}" Content="Check again" Click="Check_Click" HorizontalAlignment="Left" Margin="0,12,0,12"/>
     <ItemsControl x:Name="Readings"><ItemsControl.ItemTemplate><DataTemplate>
      <Border Style="{StaticResource WorkspaceCard}" Padding="12" Margin="0,0,0,8"><StackPanel>
       <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextWrapping="Wrap"/>
       <TextBlock Text="{Binding Detail}" Style="{StaticResource MutedText}" Margin="0,4,0,0"/>
      </StackPanel></Border>
     </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
     <TextBlock Style="{StaticResource MutedText}" Text="Keep OpenTokenUsage running in the notification area beside the Windows clock. BELAC Dock will pick up its updates automatically."/>
    </StackPanel>
    <Button Style="{StaticResource TextButton}" Content="Read the step-by-step setup guide ↗" HorizontalAlignment="Left" Margin="0,20,0,0" Click="Guide_Click"/>
    <TextBlock x:Name="ActionError" Foreground="{DynamicResource Brush.Warn}" TextWrapping="Wrap" Margin="0,8,0,0" AutomationProperties.LiveSetting="Polite"/>
   </StackPanel>
  </ScrollViewer>
 </DockPanel>
</Window>
