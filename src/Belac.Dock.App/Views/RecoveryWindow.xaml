<Window x:Class="Belac.Dock.App.Views.RecoveryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Restore windows"
        Width="460"
        SizeToContent="Height"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="{DynamicResource Brush.Background}"
        Foreground="{DynamicResource Brush.Foreground}"
        FontFamily="Segoe UI Variable Text, Segoe UI">
    <StackPanel Margin="20">
        <TextBlock Style="{StaticResource TitleText}" Text="Restore managed windows"/>
        <TextBlock x:Name="Body" Style="{StaticResource BodyText}" Margin="0,10,0,0"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button Style="{StaticResource TextButton}" Content="Forget snapshots" IsCancel="True" AutomationProperties.Name="Forget snapshots"/>
            <Button Style="{StaticResource TextButton}" Content="Restore windows" IsDefault="True" Click="Restore_Click" AutomationProperties.Name="Restore windows"/>
        </StackPanel>
    </StackPanel>
</Window>
