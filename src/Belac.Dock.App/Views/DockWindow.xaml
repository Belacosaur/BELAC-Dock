<Window x:Class="Belac.Dock.App.Views.DockWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:vm="clr-namespace:Belac.Dock.App.ViewModels" xmlns:views="clr-namespace:Belac.Dock.App.Views" xmlns:local="clr-namespace:Belac.Dock.App"
 Title="BELAC Dock" WindowStyle="None" ResizeMode="CanResize" ShowInTaskbar="False" ShowActivated="False" Topmost="True"
 AllowsTransparency="True" Background="Transparent" Width="84" Height="800" MinWidth="76" MinHeight="400"
 FontFamily="Segoe UI Variable Text, Segoe UI" UseLayoutRounding="True" SnapsToDevicePixels="True" TextOptions.TextFormattingMode="Display"
 AllowDrop="True" Drop="Window_Drop" PreviewKeyDown="Window_PreviewKeyDown">
 <Window.Resources>
  <Style x:Key="RailScrollViewer" TargetType="ScrollViewer">
   <Setter Property="VerticalScrollBarVisibility" Value="Hidden"/><Setter Property="HorizontalScrollBarVisibility" Value="Disabled"/>
   <Setter Property="Padding" Value="2"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ScrollViewer">
    <ScrollContentPresenter x:Name="PART_ScrollContentPresenter" Margin="{TemplateBinding Padding}" Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}" CanContentScroll="{TemplateBinding CanContentScroll}"/>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <local:UsageNoteVisibilityConverter x:Key="UsageNoteVisibility"/>
  <local:UsageMetricPresentationConverter x:Key="MetricPresentation"/>
  <DataTemplate x:Key="AppTemplate" DataType="{x:Type vm:AppItemViewModel}">
   <StackPanel Margin="0,3">
    <Border Height="1" Width="24" Background="{DynamicResource Brush.Border}" Margin="0,7,0,7" Visibility="{Binding ShowDivider, Converter={StaticResource BoolVis}}"/>
    <Button Style="{StaticResource IconButton}" Width="48" Height="48" HorizontalAlignment="Center" Command="{Binding DataContext.ActivateItemCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" ToolTip="{Binding Tooltip}" AutomationProperties.Name="{Binding DisplayName}">
     <Grid Width="46" Height="46">
      <Border Width="3" Height="{Binding PillHeight}" Opacity="{Binding PillOpacity}" Background="{DynamicResource Brush.Accent}" CornerRadius="2" HorizontalAlignment="Left" VerticalAlignment="Center"/>
      <Grid Width="34" Height="34" HorizontalAlignment="Center" VerticalAlignment="Center">
       <TextBlock Text="{Binding Monogram}" FontSize="17" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Accent}" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding Icon, Converter={StaticResource NullVisInvert}}"/>
       <Image Source="{Binding Icon}" Width="{Binding ImageSize}" Height="{Binding ImageSize}" MaxWidth="34" MaxHeight="34" RenderOptions.BitmapScalingMode="HighQuality"/>
      </Grid>
      <Ellipse Width="5" Height="5" Fill="{DynamicResource Brush.Good}" HorizontalAlignment="Center" VerticalAlignment="Bottom" Visibility="{Binding IsRunning, Converter={StaticResource BoolVis}}"/>
      <Ellipse Width="7" Height="7" Fill="{DynamicResource Brush.Warn}" HorizontalAlignment="Right" VerticalAlignment="Top" Visibility="{Binding HasWarning, Converter={StaticResource BoolVis}}"/>
      <Border Background="{DynamicResource Brush.Surface}" CornerRadius="6" Padding="3,1" HorizontalAlignment="Right" VerticalAlignment="Bottom" Visibility="{Binding HasMultiple, Converter={StaticResource BoolVis}}"><TextBlock Text="{Binding WindowCount}" FontSize="9" Foreground="{DynamicResource Brush.Foreground}"/></Border>
     </Grid>
    </Button>
   </StackPanel>
  </DataTemplate>
  <DataTemplate x:Key="GroupTemplate" DataType="{x:Type vm:GroupStubViewModel}">
   <Button Style="{StaticResource IconButton}" Width="48" Height="40" Command="{Binding DataContext.ToggleGroupCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" ToolTip="{Binding Label}" AutomationProperties.Name="{Binding Label}"><TextBlock Text="&#xE8B7;" FontFamily="Segoe MDL2 Assets" Foreground="{DynamicResource Brush.Muted}"/></Button>
  </DataTemplate>
  <views:DockTemplateSelector x:Key="RowSelector" AppTemplate="{StaticResource AppTemplate}" GroupTemplate="{StaticResource GroupTemplate}"/>
  <DataTemplate DataType="{x:Type local:UsageMetricPresentation}">
   <StackPanel>
    <StackPanel Margin="0,0,0,18" Visibility="{Binding IsMetric, Converter={StaticResource BoolVis}}">
     <TextBlock Text="{Binding Label}" FontSize="13" FontWeight="Medium" Foreground="{DynamicResource Brush.Foreground}" Margin="0,0,0,7"/>
     <ProgressBar Style="{StaticResource WorkspaceProgress}" Height="7" Value="{Binding Percent}" Foreground="{Binding DataContext.UsageDetail.OuterBrush, Source={x:Reference FlyoutPopup}}"/>
     <Grid Margin="0,6,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <TextBlock Text="{Binding Value}" FontSize="11" Foreground="{DynamicResource Brush.Foreground}"/>
      <TextBlock Grid.Column="1" Text="{Binding Reset}" ToolTip="{Binding FullReset}" FontSize="11" TextWrapping="Wrap" TextAlignment="Right" Margin="12,0,0,0" Foreground="{DynamicResource Brush.Muted}"/>
     </Grid>
    </StackPanel>
    <Border Visibility="{Binding IsMetric, Converter={StaticResource BoolVisInvert}}">
     <TextBlock Text="{Binding Label}" TextWrapping="Wrap" Foreground="{DynamicResource Brush.Muted}" FontSize="11" Margin="0,0,0,7">
      <TextBlock.Visibility><MultiBinding Converter="{StaticResource UsageNoteVisibility}"><Binding Path="Label"/><Binding Path="DataContext.UsageDetail.Plan" Source="{x:Reference FlyoutPopup}"/></MultiBinding></TextBlock.Visibility>
     </TextBlock>
    </Border>
   </StackPanel>
  </DataTemplate>
 </Window.Resources>
 <Grid Margin="6">
  <Border x:Name="Shell" CornerRadius="20" Background="{DynamicResource Brush.Background}" BorderBrush="{DynamicResource Brush.BorderStrong}" BorderThickness="1" Visibility="{Binding IsCollapsed, Converter={StaticResource BoolVisInvert}}">
   <Border.Effect><DropShadowEffect BlurRadius="12" ShadowDepth="2" Opacity="0.2"/></Border.Effect>
   <Grid Margin="4,18,4,10">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Button Style="{StaticResource IconButton}" Width="48" Height="42" Margin="0,0,0,8" Command="{Binding ShowSearchCommand}" ToolTip="Find an app (Ctrl+K)" AutomationProperties.Name="Search apps"><TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets" FontSize="16" Foreground="{DynamicResource Brush.Muted}"/></Button>
    <Grid Grid.Row="1">
     <ListBox x:Name="AppList" Style="{StaticResource DockList}" ItemContainerStyle="{StaticResource DockListItem}" ScrollViewer.VerticalScrollBarVisibility="Hidden" ItemsSource="{Binding Rows}" ItemTemplateSelector="{StaticResource RowSelector}" AllowDrop="True" PreviewMouseLeftButtonDown="List_PreviewMouseLeftButtonDown" PreviewMouseMove="List_MouseMove" Drop="List_Drop" ContextMenuOpening="Row_ContextMenuOpening"/>
     <Button Style="{StaticResource IconButton}" Width="44" Height="44" VerticalAlignment="Top" Command="{Binding OpenAddCommand}" ToolTip="Add your first app, or drop an app here" AutomationProperties.Name="Add first app" Visibility="{Binding HasApps, Converter={StaticResource BoolVisInvert}}"><TextBlock Text="&#xE710;" FontFamily="Segoe MDL2 Assets" Foreground="{DynamicResource Brush.Accent}"/></Button>
    </Grid>
    <StackPanel Grid.Row="2" Margin="0,6,0,6">
     <Button Style="{StaticResource CommandButton}" Width="28" Height="24" Content="!" Foreground="{DynamicResource Brush.Warn}" Command="{Binding DismissWarningCommand}" ToolTip="{Binding LoadWarning}" Visibility="{Binding LoadWarning, Converter={StaticResource NullVis}}"/>
     <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
      <Button Style="{StaticResource CommandButton}" Width="24" Height="28" FontSize="12" Content="&#xE710;" Command="{Binding OpenAddCommand}" ToolTip="Add app" AutomationProperties.Name="Add local app"/>
      <Button Style="{StaticResource CommandButton}" Width="24" Height="28" FontSize="12" Content="&#xE713;" Command="{Binding OpenSettingsCommand}" ToolTip="Settings" AutomationProperties.Name="Settings"/>
     </StackPanel>
    </StackPanel>
    <Border x:Name="UsageRail" Grid.Row="3" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,1,0,0" Padding="0,8,0,0" Visibility="{Binding Usage.IsEnabled, Converter={StaticResource BoolVis}}">
     <StackPanel>
      <ScrollViewer x:Name="UsageScroll" Style="{StaticResource RailScrollViewer}">
       <ItemsControl ItemsSource="{Binding Usage.Providers}"><ItemsControl.ItemTemplate><DataTemplate DataType="{x:Type vm:ProviderRowViewModel}">
        <Button Style="{StaticResource IconButton}" Width="48" Height="52" Margin="0,2" HorizontalAlignment="Center" Command="{Binding DataContext.ShowUsageCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" Click="UsageProvider_Click" ToolTip="{Binding Tooltip}" AutomationProperties.Name="{Binding DisplayName}">
         <Grid><views:ProviderRingControl ProviderName="{Binding DisplayName}" Width="42" Height="42" OuterPercent="{Binding OuterPercent}" InnerPercent="{Binding InnerPercent}" OuterBrush="{Binding OuterBrush}" InnerBrush="{Binding InnerBrush}" Monogram="{Binding Monogram}" IsStale="{Binding IsStale}" Visibility="{Binding HasRing, Converter={StaticResource BoolVis}}"/>
          <views:ProviderLogo Provider="{Binding DisplayName}" Width="20" Height="20" Visibility="{Binding HasRing, Converter={StaticResource BoolVisInvert}}"/>
         </Grid>
        </Button>
       </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
      </ScrollViewer>
      <Button Style="{StaticResource IconButton}" Width="44" Height="42" Command="{Binding ConnectUsageCommand}" ToolTip="Connect AI usage — guided setup" AutomationProperties.Name="Connect usage" Visibility="{Binding Usage.HasData, Converter={StaticResource BoolVisInvert}}"><TextBlock Text="&#xE9D9;" FontFamily="Segoe MDL2 Assets" Foreground="{DynamicResource Brush.Muted}"/></Button>
     </StackPanel>
    </Border>
   </Grid>
  </Border>
  <Border x:Name="CompactShell" Background="{DynamicResource Brush.Background}" BorderBrush="{DynamicResource Brush.BorderStrong}" BorderThickness="1" CornerRadius="16" VerticalAlignment="Center" Visibility="{Binding IsCollapsed, Converter={StaticResource BoolVis}}"><Button Style="{StaticResource CommandButton}" Width="32" Height="48" Content="{Binding ExpandGlyph}" Command="{Binding ToggleCollapseCommand}" AutomationProperties.Name="Expand dock"/></Border>
  <Border Height="18" VerticalAlignment="Top" Background="Transparent" Cursor="SizeAll" MouseLeftButtonDown="DragHandle_MouseLeftButtonDown" ToolTip="Drag to move"><Border Width="28" Height="3" Background="{DynamicResource Brush.BorderStrong}" CornerRadius="2" VerticalAlignment="Center"/></Border>
  <Thumb Width="24" Height="16" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,7,4" Cursor="SizeNWSE" Focusable="True" PreviewKeyDown="ResizeGrip_PreviewKeyDown" DragStarted="ResizeGrip_DragStarted" DragDelta="ResizeGrip_DragDelta" DragCompleted="ResizeGrip_DragCompleted" Visibility="{Binding IsCollapsed, Converter={StaticResource BoolVisInvert}}" ToolTip="Resize bar" AutomationProperties.Name="Resize dock"><Thumb.Template><ControlTemplate TargetType="Thumb"><Border Background="Transparent"><Path Data="M 7,12 L 15,4 M 12,12 L 15,9" Stroke="{DynamicResource Brush.Muted}" StrokeThickness="1.3"/></Border></ControlTemplate></Thumb.Template></Thumb>
  <Popup x:Name="FlyoutPopup" Placement="Left" PlacementTarget="{Binding ElementName=Shell}" IsOpen="{Binding FlyoutOpen, Mode=TwoWay}" StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade">
   <Border x:Name="FlyoutSurface" Width="370" MaxHeight="620" CornerRadius="18" Background="{DynamicResource Brush.Flyout}" BorderBrush="{DynamicResource Brush.BorderStrong}" BorderThickness="1" Padding="22" PreviewKeyDown="Flyout_PreviewKeyDown">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
     <StackPanel>
      <DockPanel Margin="0,0,0,12"><Button x:Name="ClosePanelButton" DockPanel.Dock="Right" Style="{StaticResource CommandButton}" Content="&#xE711;" Width="24" Height="24" Click="CloseFlyout_Click" AutomationProperties.Name="Close panel" ToolTip="Close (Esc)"/><TextBlock Text="{Binding Flyout}" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Muted}" VerticalAlignment="Center"/></DockPanel>
      <StackPanel Visibility="{Binding Flyout, Converter={StaticResource EnumVis}, ConverterParameter=Search}">
       <TextBlock Text="Jump back in." FontSize="26" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Foreground}"/>
       <TextBlock Text="Find an app and press Enter to open it." FontSize="12" Foreground="{DynamicResource Brush.Muted}" Margin="0,6,0,16"/>
       <TextBox x:Name="SearchField" PreviewKeyDown="SearchField_PreviewKeyDown" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Padding="14,12" FontSize="14" Margin="0,0,0,14" AutomationProperties.Name="Search apps"/>
       <ItemsControl ItemsSource="{Binding SearchResults}"><ItemsControl.ItemTemplate><DataTemplate>
        <Button Style="{StaticResource CardButton}" Command="{Binding DataContext.ActivateItemCommand, Source={x:Reference FlyoutPopup}}" CommandParameter="{Binding}" AutomationProperties.Name="{Binding DisplayName}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="42"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Image Source="{Binding Icon}" Width="28" Height="28"/><StackPanel Grid.Column="1"><TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold"/><TextBlock Text="{Binding GroupLabel}" Foreground="{DynamicResource Brush.Muted}" FontSize="11" Margin="0,4,0,0"/></StackPanel></Grid></Button>
       </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
       <TextBlock Text="No matching apps. Try another name." Foreground="{DynamicResource Brush.Muted}" TextWrapping="Wrap" Margin="0,8"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding SearchResults.Count}" Value="0"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
      </StackPanel>
      <StackPanel Visibility="{Binding Flyout, Converter={StaticResource EnumVis}, ConverterParameter=Windows}">
       <TextBlock Text="{Binding ChooserTitle}" FontSize="23" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Foreground}"/><TextBlock Text="Choose a window to continue." Foreground="{DynamicResource Brush.Muted}" Margin="0,6,0,16"/>
       <ItemsControl ItemsSource="{Binding ChooserWindows}"><ItemsControl.ItemTemplate><DataTemplate><Button Style="{StaticResource CardButton}" Background="{DynamicResource Brush.Surface}" Command="{Binding DataContext.ChooseWindowCommand, Source={x:Reference FlyoutPopup}}" CommandParameter="{Binding}"><StackPanel><TextBlock Text="{Binding Title}" TextWrapping="Wrap" FontWeight="SemiBold"/><TextBlock Text="{Binding Detail}" Foreground="{DynamicResource Brush.Muted}" FontSize="11" Margin="0,6,0,0"/></StackPanel></Button></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
      </StackPanel>
      <StackPanel Visibility="{Binding Flyout, Converter={StaticResource EnumVis}, ConverterParameter=Usage}">
       <Grid Margin="0,0,0,22"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <views:ProviderLogo Provider="{Binding UsageDetail.DisplayName}" Width="26" Height="26" Margin="0,0,12,0"/>
        <TextBlock Grid.Column="1" Text="{Binding UsageDetail.DisplayName}" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap" VerticalAlignment="Center" Foreground="{DynamicResource Brush.Foreground}"/>
        <TextBlock Grid.Column="2" Text="{Binding UsageDetail.Plan}" MaxWidth="100" TextWrapping="Wrap" TextAlignment="Right" FontSize="11" Foreground="{DynamicResource Brush.Muted}" Margin="12,0,0,0" VerticalAlignment="Center"/>
       </Grid>
       <ItemsControl ItemsSource="{Binding UsageDetail.Details}"><ItemsControl.ItemTemplate><DataTemplate><ContentControl Content="{Binding Converter={StaticResource MetricPresentation}}"/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
       <Grid Margin="0,8,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Button Style="{StaticResource TextButton}" Background="Transparent" BorderThickness="0" Padding="0,6" HorizontalAlignment="Left" Content="↻  Refresh" Command="{Binding RefreshUsageCommand}"/><Button Grid.Column="1" Style="{StaticResource CommandButton}" Content="&#xE8A7;" Command="{Binding OpenUsageAppCommand}" ToolTip="Open OpenTokenUsage" AutomationProperties.Name="Open OpenTokenUsage"/></Grid>
      </StackPanel>
      <TextBlock Text="{Binding StatusText}" Foreground="{DynamicResource Brush.Muted}" TextWrapping="Wrap" FontSize="11" Margin="0,12,0,0" Visibility="{Binding StatusText, Converter={StaticResource NullVis}}"/>
     </StackPanel>
    </ScrollViewer>
   </Border>
  </Popup>
 </Grid>
</Window>
