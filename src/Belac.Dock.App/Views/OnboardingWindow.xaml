<Window x:Class="Belac.Dock.App.Views.OnboardingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Belac.Dock.App"
        local:DialogChrome.DarkCaption="True"
        Title="Welcome to BELAC Dock"
        Width="560"
        Height="460"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="{DynamicResource Brush.Background}"
        Foreground="{DynamicResource Brush.Foreground}"
        FontFamily="Segoe UI Variable Text, Segoe UI">
    <DockPanel Margin="24">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Style="{StaticResource TextButton}" Content="Back" Click="Back_Click" x:Name="BackButton"/>
            <Button Style="{StaticResource TextButton}" Content="Next" Click="Next_Click" x:Name="NextButton" AutomationProperties.Name="Next"/>
        </StackPanel>
        <StackPanel x:Name="Welcome">
            <TextBlock Style="{StaticResource TitleText}" Text="Your workspace, within reach"/>
            <TextBlock Style="{StaticResource BodyText}" Margin="0,12,0,0" Text="BELAC Dock is a vertical switcher for the local programs you choose. The Windows taskbar at the bottom stays in place for everything else."/>
        </StackPanel>
        <StackPanel x:Name="MonitorStep" Visibility="Collapsed">
            <TextBlock Style="{StaticResource TitleText}" Text="Choose a monitor"/>
            <TextBlock Style="{StaticResource MutedText}" Margin="0,8,0,8" Text="The dock starts near the screen edge. Drag its top handle to place it anywhere, then use the lower corner to find your perfect size."/>
            <ComboBox x:Name="MonitorBox" DisplayMemberPath="Label"/>
        </StackPanel>
        <StackPanel x:Name="AppsStep" Visibility="Collapsed">
            <TextBlock Style="{StaticResource TitleText}" Text="Add local apps"/>
            <TextBlock Style="{StaticResource MutedText}" Margin="0,8,0,8" Text="You can add more later. Executable locations are yours to choose. Groups for TCG Hunter, RIPT, BELAC Orchestrator, and Services are ready and empty."/>
            <TextBox x:Name="SearchBox" Margin="0,0,0,8" TextChanged="SearchBox_TextChanged" AutomationProperties.Name="Search installed apps"/>
            <ListBox x:Name="InstalledList" Height="120" Background="{DynamicResource Brush.Surface}" Foreground="{DynamicResource Brush.Foreground}" MouseDoubleClick="Installed_DoubleClick"/>
            <ListBox x:Name="AddedList" Height="80" Margin="0,8,0,0" Background="{DynamicResource Brush.Surface}" Foreground="{DynamicResource Brush.Foreground}"/>
            <Button Style="{StaticResource TextButton}" Content="Browse for an app" Margin="0,8,0,0" Click="Browse_Click" AutomationProperties.Name="Browse for an app"/>
        </StackPanel>
        <StackPanel x:Name="SeparationStep" Visibility="Collapsed">
            <TextBlock Style="{StaticResource TitleText}" Text="Ready for your workspace"/>
            <TextBlock Style="{StaticResource BodyText}" Margin="0,12,0,0" Text="Apps appear on the dock and on the normal taskbar. Dock-only is a per-app experiment. Windows may refuse it. A compatibility style change can also remove the Alt+Tab entry, and you can always restore it from the tray."/>
            <Button Style="{StaticResource TextButton}" Content="Connect AI usage… (optional)" Click="ConnectUsage_Click" Margin="0,18,0,0"/>
            <TextBlock Style="{StaticResource MutedText}" Text="A short guided setup for the usage rings. You can also do this later in Settings → Usage." Margin="0,8,0,0"/>
        </StackPanel>
    </DockPanel>
</Window>
