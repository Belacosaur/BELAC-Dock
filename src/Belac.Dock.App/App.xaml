<Application x:Class="Belac.Dock.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Belac.Dock.App"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Styles/Colors.xaml"/>
                <ResourceDictionary Source="Styles/Typography.xaml"/>
                <ResourceDictionary Source="Styles/Controls.xaml"/>
                <ResourceDictionary Source="Styles/Workspace.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <local:BoolVisibilityConverter x:Key="BoolVis"/>
            <local:BoolVisibilityConverter x:Key="BoolVisInvert" Invert="True"/>
            <local:EnumVisibilityConverter x:Key="EnumVis"/>
            <local:NullVisibilityConverter x:Key="NullVis"/>
            <local:NullVisibilityConverter x:Key="NullVisInvert" Invert="True"/>
        </ResourceDictionary>
    </Application.Resources>
</Application>
