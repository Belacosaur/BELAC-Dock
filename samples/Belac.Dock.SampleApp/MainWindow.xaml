<Window x:Class="Belac.Dock.SampleApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="BELAC Dock Sample"
        Width="460"
        Height="300"
        WindowStartupLocation="CenterScreen"
        Background="#151B26"
        Foreground="#E7EEF8"
        FontFamily="Segoe UI Variable Text, Segoe UI">
    <StackPanel Margin="24">
        <TextBlock FontSize="22" FontWeight="SemiBold" Text="Cooperative sample"/>
        <TextBlock Margin="0,10,0,0" TextWrapping="Wrap" Foreground="#AAB9CC" Text="This window can hide its own taskbar button. Ordinary dock apps do not need this. Add the sample executable to BELAC Dock if you want to watch Dock-only against a window we control."/>
        <TextBlock x:Name="PathText" Margin="0,10,0,0" TextWrapping="Wrap" Foreground="#7DB5FF"/>
        <Button Margin="0,16,0,0" Padding="12,8" Content="Hide my taskbar button" Click="Hide_Click"/>
        <Button Margin="0,8,0,0" Padding="12,8" Content="Show my taskbar button" Click="Show_Click"/>
    </StackPanel>
</Window>
